generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String
  username       String    @unique @map("email")
  passwordHash   String
  role           String    @default("EMPLOYEE") // ADMIN, MANAGER, EMPLOYEE
  permissions    String?   // JSON array; null uses role defaults
  employeeId     String?   @unique
  isActive       Boolean   @default(true)
  isPrimaryAdmin Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee       Employee?               @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdTasks   Task[]                  @relation("TaskCreatedBy")
  statusChanges  TaskStatusHistory[]     @relation("StatusChangedBy")
  changeLogs     TaskChangeLog[]         @relation("ChangeLogChangedBy")
  comments       TaskComment[]           @relation("CommentAuthor")
  assignmentsAs  TaskAssignmentHistory[] @relation("AssignedBy")
  commentDeletes TaskComment[]           @relation("CommentDeletedBy")
  recordedNippoAbsences NippoAbsence[]   @relation("NippoAbsenceRecordedBy")
  auditLogs        AuditLog[]             @relation("AuditActor")
  createdTestEnvironments TestEnvironment[] @relation("TestEnvironmentCreatedBy")
  releasedTestEnvironmentUsages TestEnvironmentUsage[] @relation("TestEnvironmentUsageReleasedBy")
  createdTestDevices TestDevice[] @relation("TestDeviceCreatedBy")
  returnedTestDeviceUsages TestDeviceUsage[] @relation("TestDeviceUsageReturnedBy")

  @@index([deletedAt])
  @@map("users")
}

model Employee {
  id           String   @id @default(cuid())
  employeeCode String
  fullName     String
  email        String?
  department   String   @default("")
  position     String   @default("")
  teamId       String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user              User?                    @relation
  team              Team?                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  ledTeams          Team[]                   @relation("TeamLead")
  tasks             Task[]                   @relation("TaskAssignee")
  assignmentHistory TaskAssignmentHistory[]  @relation("AssignmentEmployee")
  teamMemberships   TeamMember[]
  nippoReports       NippoReport[]
  nippoAbsences      NippoAbsence[]
  testEnvironments   TestEnvironment[]
  testEnvironmentUsages TestEnvironmentUsage[]
  testDevices        TestDevice[]         @relation("TestDeviceHolder")
  testDeviceUsages   TestDeviceUsage[]    @relation("TestDeviceUsageEmployee")

  @@map("employees")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String   @default("🐉")
  leadId      String?  @unique
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lead     Employee?    @relation("TeamLead", fields: [leadId], references: [id], onDelete: SetNull)
  members  TeamMember[]
  employees Employee[]
  nippoReports NippoReport[]
  nippoAbsences NippoAbsence[]

  @@map("teams")
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  employeeId String
  joinedAt   DateTime @default(now())

  team     Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([teamId, employeeId])
  @@map("team_members")
}

model Product {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  color     String   @default("#6B7280")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  testEnvironments TestEnvironment[]

  @@map("products")
}

model DailyWorkCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  nameVi    String
  nameJa    String
  color     String   @default("#8B5CF6")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("daily_work_categories")
}

model TestEnvironment {
  id             String    @id @default(cuid())
  type           String    @default("PERSONAL") // PERSONAL, SHARED
  productId      String
  employeeId     String?
  usagePeriod    DateTime? // 使用開始日・更新日 (ngày bắt đầu dùng)
  usageEndDate   DateTime? // Hạn trả của lượt đăng ký hiện tại (dùng chung)
  os             String?
  setupType      String    @default("NEW") // NEW, UPDATE
  virus          String?   // tình trạng antivirus + version
  hostName       String?   // ホスト名（ssh先）
  ip             String?
  url            String?
  deliveryDomain String?   // 配送ドメイン名
  version        String?
  buildInfo      String?   // BuildInfo, vd 2.20.0(29845)
  commonVersion  String?   // common, vd 12.48.1(28380)
  sophosVersion  String?   // sophos, vd 3.5.0(29733)
  isActive       Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdBy User      @relation("TestEnvironmentCreatedBy", fields: [createdById], references: [id])
  usages    TestEnvironmentUsage[]

  @@index([type])
  @@index([productId])
  @@index([employeeId])
  @@index([usageEndDate])
  @@map("test_environments")
}

// Lịch sử từng lượt đăng ký dùng môi trường (đặc biệt là môi trường dùng chung).
// Bản ghi còn mở khi releasedAt = null.
model TestEnvironmentUsage {
  id             String    @id @default(cuid())
  environmentId  String
  employeeId     String
  startDate      DateTime
  endDate        DateTime
  registeredAt   DateTime  @default(now())
  releasedAt     DateTime?
  releasedById   String?
  releaseReason  String?

  environment TestEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  releasedBy  User?           @relation("TestEnvironmentUsageReleasedBy", fields: [releasedById], references: [id], onDelete: SetNull)

  @@index([environmentId, registeredAt])
  @@index([employeeId, releasedAt])
  @@index([endDate])
  @@map("test_environment_usages")
}

// Thiết bị test vật lý (máy Burp, MacBook, điện thoại...) và lịch sử mượn/trả.
// Chỉ có một lượt mở (returnedAt = null) cho mỗi thiết bị tại một thời điểm.
model TestDevice {
  id             String    @id @default(cuid())
  code           String    @unique
  name           String
  category       String    @default("LAPTOP") // LAPTOP, DESKTOP, PHONE, TABLET, OTHER
  purpose        String?
  os             String?
  serialNumber   String?
  location       String?
  note           String?
  status         String    @default("AVAILABLE") // AVAILABLE, IN_USE, MAINTENANCE, RETIRED
  employeeId     String?
  usageStartDate DateTime?
  usageEndDate   DateTime?
  isActive       Boolean   @default(true)
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employee  Employee?         @relation("TestDeviceHolder", fields: [employeeId], references: [id], onDelete: SetNull)
  createdBy User?             @relation("TestDeviceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  usages    TestDeviceUsage[]

  @@index([status])
  @@index([employeeId])
  @@index([usageEndDate])
  @@map("test_devices")
}

model TestDeviceUsage {
  id              String    @id @default(cuid())
  deviceId        String
  employeeId      String
  startDate       DateTime
  endDate         DateTime
  checkedOutAt    DateTime  @default(now())
  returnedAt      DateTime?
  returnedById    String?
  returnCondition String?   // OK, DAMAGED, LOST
  note            String?

  device     TestDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee   Employee   @relation("TestDeviceUsageEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  returnedBy User?      @relation("TestDeviceUsageReturnedBy", fields: [returnedById], references: [id], onDelete: SetNull)

  @@index([deviceId, checkedOutAt])
  @@index([employeeId, returnedAt])
  @@index([endDate])
  @@map("test_device_usages")
}

// Danh sách OS cho ô chọn ở màn hình Môi trường test.
// Quản lý trên UI tại Cài đặt (Admin). TestEnvironment.os vẫn là text để giữ
// giá trị cũ khi option bị đổi tên/xóa.
model TestEnvironmentOsOption {
  id        String   @id @default(cuid())
  name      String   @unique
  groupName String   @default("Khác")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("test_environment_os_options")
}

model Task {
  id                String    @id @default(cuid())
  taskCode          String
  taskName          String
  description       String?
  workType          String    @default("PRODUCT") // PRODUCT, DAILY
  dailyCategory     String?   // MEETING, TRAINING, SUPPORT, DOCUMENTATION, REPORT, PRACTICE, OTHER
  productId         String?
  currentAssigneeId String?
  assignmentGroupId String?   // Links per-person copies created from one multi-assignee DAILY task
  createdById       String
  plannedStartDate  DateTime?
  plannedEndDate    DateTime?
  plannedStartTime  String?
  plannedEndTime    String?
  actualStartDate   DateTime?
  actualEndDate     DateTime?
  status            String    @default("PLANNED") // PLANNED, IN_PROGRESS, WAITING, COMPLETED, CANCELLED
  progress          Int       @default(0)
  priority          String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  note              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  product           Product?                 @relation(fields: [productId], references: [id])
  currentAssignee   Employee?                @relation("TaskAssignee", fields: [currentAssigneeId], references: [id], onDelete: SetNull)
  createdBy         User                     @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignmentHistory TaskAssignmentHistory[]
  statusHistory     TaskStatusHistory[]
  changeLogs        TaskChangeLog[]
  comments          TaskComment[]
  nippoItems        NippoItem[]

  @@index([productId])
  @@index([taskCode])
  @@index([currentAssigneeId])
  @@index([assignmentGroupId])
  @@index([status])
  @@index([workType])
  @@index([plannedStartDate, plannedEndDate])
  @@index([deletedAt])
  @@map("tasks")
}

model TaskAssignmentHistory {
  id            String    @id @default(cuid())
  taskId        String
  employeeId    String
  assignedById  String
  assignedFrom  DateTime
  assignedUntil DateTime?
  reason        String?
  createdAt     DateTime  @default(now())

  task       Task     @relation(fields: [taskId], references: [id])
  employee   Employee @relation("AssignmentEmployee", fields: [employeeId], references: [id])
  assignedBy User     @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([taskId])
  @@index([employeeId])
  @@map("task_assignment_history")
}

model TaskStatusHistory {
  id          String   @id @default(cuid())
  taskId      String
  oldStatus   String
  newStatus   String
  changedById String
  note        String?
  changedAt   DateTime @default(now())

  task      Task @relation(fields: [taskId], references: [id])
  changedBy User @relation("StatusChangedBy", fields: [changedById], references: [id])

  @@index([taskId])
  @@map("task_status_history")
}

model TaskChangeLog {
  id          String   @id @default(cuid())
  taskId      String
  changedById String
  fieldName   String
  oldValue    String?
  newValue    String?
  changedAt   DateTime @default(now())

  task      Task @relation(fields: [taskId], references: [id])
  changedBy User @relation("ChangeLogChangedBy", fields: [changedById], references: [id])

  @@index([taskId])
  @@map("task_change_logs")
}

model TaskComment {
  id          String    @id @default(cuid())
  taskId      String
  authorId    String
  content     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  deletedById String?

  task      Task  @relation(fields: [taskId], references: [id])
  author    User  @relation("CommentAuthor", fields: [authorId], references: [id])
  deletedBy User? @relation("CommentDeletedBy", fields: [deletedById], references: [id])

  @@index([taskId])
  @@map("task_comments")
}

model NippoReport {
  id          String    @id @default(cuid())
  reportDate  DateTime
  employeeId  String
  teamId      String?
  status      String    @default("DRAFT") // DRAFT, SUBMITTED
  summary     String?
  blockers    String?
  nextPlan    String?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  employee Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  team     Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  items    NippoItem[]

  @@unique([employeeId, reportDate])
  @@index([reportDate])
  @@index([teamId, reportDate])
  @@map("nippo_reports")
}

model NippoItem {
  id             String   @id @default(cuid())
  reportId       String
  taskId         String?
  title          String
  workContent    String?
  result         String?
  hours          Float    @default(0)
  progressBefore Int?
  progressAfter  Int?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  report NippoReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  task   Task?       @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([reportId])
  @@index([taskId])
  @@map("nippo_items")
}

model NippoAbsence {
  id           String   @id @default(cuid())
  absenceDate  DateTime
  teamId       String
  employeeId   String
  absenceType  String   @default("PAID") // PAID, SICK, PERSONAL, OTHER
  period       String   @default("FULL") // FULL, HALF_AM, HALF_PM
  reason       String?
  recordedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  recordedBy User     @relation("NippoAbsenceRecordedBy", fields: [recordedById], references: [id])

  @@unique([employeeId, absenceDate])
  @@index([teamId, absenceDate])
  @@map("nippo_absences")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actorName     String
  actorUsername String
  action        String
  entityType    String
  entityId      String?
  entityLabel   String?
  details       String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, action, createdAt])
  @@map("audit_logs")
}
